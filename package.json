{
  "name": "encode-this",
  "version": "0.1.3",
  "description": "Open-source batch media encoder — Adobe Media Encoder / Shutter Encoder style",
  "main": "./out/main/index.js",
  "author": "nuclearfessel",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "download-ffmpeg": "node scripts/download-ffmpeg.mjs",
    "postinstall": "node scripts/download-ffmpeg.mjs",
    "pack": "npm run download-ffmpeg && npm run build && electron-builder --dir",
    "dist": "npm run download-ffmpeg && npm run build && electron-builder",
    "dist:win": "npm run download-ffmpeg && npm run build && electron-builder --win",
    "dist:mac": "npm run download-ffmpeg && npm run build && electron-builder --mac",
    "catalog:stats": "tsx scripts/catalog-stats.ts",
    "package:cep": "node scripts/package-ae-cep.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@keyline-icons/react": "^1.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "build": {
    "appId": "com.encode-this.app",
    "productName": "Encode This",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": null,
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip",
        "pkg"
      ]
    },
    "pkg": {
      "scripts": "build/pkg-scripts"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
